# App
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-value

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/social_os

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# CORS - JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000"]

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# Google OAuth (Google Login) - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# AI Providers - only the ones you configure are usable; requests to an
# unconfigured provider fail loudly (503) rather than returning fake output.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEFAULT_AI_PROVIDER=openai

# AI video generation - which provider /video/generate uses when the request
# doesn't specify one (the UI lets you pick per-generation either way)
DEFAULT_VIDEO_PROVIDER=replicate

# Replicate - https://replicate.com/account/api-tokens
# REPLICATE_VIDEO_MODEL is an "owner/name" slug; browse options at
# https://replicate.com/collections/text-to-video. Same fail-loudly rule as
# the AI providers above: no REPLICATE_API_TOKEN means /video/generate returns
# 503, never a fake video. Also used for AI thumbnail generation regardless of
# which provider generated the video itself.
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=minimax/hailuo-2.3

# Higgsfield - https://cloud.higgsfield.ai (generate a key+secret from your
# dashboard's API section). HIGGSFIELD_MODEL is a model_id like the default
# below; see your dashboard for others (avatar/persona "soul" models, etc).
# The exact fields for training a persistent avatar on your own face/voice
# weren't confirmed from public docs — pass those via a request's
# `extra_params` once you've found the field names in your own dashboard.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_MODEL=higgsfield-ai/soul/standard

# S3-compatible object storage (media uploads)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=social-os-media
S3_REGION=us-east-1

# Rate limiting
RATE_LIMIT_DEFAULT=100/minute
