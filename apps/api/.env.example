# App
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-value

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/social_os

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# CORS - JSON array of allowed origins
CORS_ORIGINS=["http://localhost:3000"]

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# Google OAuth (Google Login) - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# AI Providers - only the ones you configure are usable; requests to an
# unconfigured provider fail loudly (503) rather than returning fake output.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEFAULT_AI_PROVIDER=openai

# AI video generation - which provider /video/generate uses when the request
# doesn't specify one (the UI lets you pick per-generation either way)
DEFAULT_VIDEO_PROVIDER=replicate

# Replicate - https://replicate.com/account/api-tokens
# REPLICATE_VIDEO_MODEL is an "owner/name" slug; browse options at
# https://replicate.com/collections/text-to-video. Same fail-loudly rule as
# the AI providers above: no REPLICATE_API_TOKEN means /video/generate returns
# 503, never a fake video. Also used for AI thumbnail generation regardless of
# which provider generated the video itself.
REPLICATE_API_TOKEN=
REPLICATE_VIDEO_MODEL=minimax/hailuo-2.3

# Higgsfield - https://cloud.higgsfield.ai (generate a key+secret from your
# dashboard's API section). HIGGSFIELD_MODEL is a model_id like the default
# below; see your dashboard for others (avatar/persona "soul" models, etc).
# The exact fields for training a persistent avatar on your own face/voice
# weren't confirmed from public docs — pass those via a request's
# `extra_params` once you've found the field names in your own dashboard.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_MODEL=higgsfield-ai/soul/standard

# Meta (Instagram/Facebook) webhooks - comment-to-lead capture
# https://developers.facebook.com/docs/graph-api/webhooks
# Setup: create a Meta App -> Products -> Webhooks -> subscribe to your Page/
# Instagram Business Account's "comments" field, pointing the callback URL at
# https://<your-public-domain>/api/v1/webhooks/meta (must be a real public
# HTTPS URL Meta can reach - localhost will not work). Use
# META_WEBHOOK_VERIFY_TOKEN (any string you invent) in both places, and copy
# META_APP_SECRET from the App dashboard. Then register your account's ID via
# POST /social-accounts (or Settings -> Connected accounts) so incoming events
# route to your leads.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# WhatsApp Business (Cloud API) - the AI answers people who message you
# https://developers.facebook.com/docs/whatsapp/cloud-api
# Setup: same Meta App -> add the WhatsApp product -> add a phone number (it must
# NOT be a number already registered to the WhatsApp or WhatsApp Business app) ->
# copy the Phone number ID and generate a permanent access token via a System User.
# Subscribe the webhook to the "messages" field; it arrives at the same
# /api/v1/webhooks/meta endpoint as comments.
#
# Cost shape, which is why this only ever replies and never initiates: answering
# inside the 24-hour customer service window is FREE, and a click from a
# Click-to-WhatsApp ad opens a 72-hour free window. Only business-initiated
# conversations are billed (India: ~Rs 0.88 marketing, ~Rs 0.115 utility per
# message). Verify current rates against Meta's own pricing page.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# S3-compatible object storage (media uploads)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=social-os-media
S3_REGION=us-east-1

# Rate limiting
RATE_LIMIT_DEFAULT=100/minute

# --- Notes on publishing ---
# Instagram, Facebook and Threads publishing all use ONE Meta developer app and
# the credentials above (META_APP_SECRET) plus per-account OAuth tokens stored
# encrypted on SocialAccount. Requirements:
#   - Instagram must be a Business or Creator account, linked to a Facebook Page
#   - Threads requires that Instagram Business account linked to a Threads profile
# Tokens are encrypted with a key derived from SECRET_KEY, so changing SECRET_KEY
# makes every stored token unreadable and each account must be reconnected.
#
# X / Twitter is intentionally not wired up: X removed its free API tier for new
# developers on 2026-02-06 (now ~$0.015 per post, $0.20 with a link).
# Threads has no Stories and no DM API. Quora has no public API at all. Reddit
# search is free but posting needs Reddit's manual OAuth approval.
#
# Everything else (auto-publish per platform, auto-DM template and keywords,
# Threads keywords, posts per day, reply language) is edited in the Settings UI,
# not here - see docs/START_HERE.md.
